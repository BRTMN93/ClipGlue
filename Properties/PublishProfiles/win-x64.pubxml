<Project>
  <!--
    Checked-in publish profile so shipping a build to another machine doesn't
    require remembering a pile of -p: flags each time. Only affects
    `dotnet publish -p:PublishProfile=win-x64` (or the Release/win-x64
    combination in Visual Studio's Publish UI) - a plain `dotnet build` or
    `dotnet publish` without this profile is completely unaffected, so the
    existing dev workflow (bin\Debug\net8.0-windows\ClipGlue.exe) stays as-is.

    win-x64 only: this app calls Win32-only APIs (NtSuspendProcess via
    P/Invoke, WPF) and ships an x64 ffmpeg.exe/ffprobe.exe, so there is no
    portable/AnyCPU publish target to offer here.
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>bin\Release\net8.0-windows\publish\win-x64\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- Deflate-compresses everything bundled inside the single exe (.NET
         runtime + WPF assemblies + the embedded ffmpeg.exe/ffprobe.exe) -
         meaningfully shrinks the ~235MB uncompressed size at the cost of a
         one-time decompression pass into a temp extraction folder on first
         run of a given version (cached after that). See AUDIT_TODO.md for
         the full size breakdown/rationale. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Embeds the .pdb into the exe instead of dropping it next to it, so
         the publish folder holds exactly one file (ClipGlue.exe) and
         nothing else - the whole point of this profile. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
